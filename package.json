{
  "name": "selective-zoom",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension for per-site text sizing",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "lint:extension": "web-ext lint --config web-ext.config.cjs",
    "build": "web-ext build --config web-ext.config.cjs",
    "dev": "web-ext run --config web-ext.config.cjs",
    "test:firefox": "python3 tests/firefox_smoke.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "web-ext": "10.8.0"
  }
}
