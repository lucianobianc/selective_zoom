{
  "name": "selective-zoom",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox extension for per-site text sizing",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "lint:extension": "web-ext lint --source-dir . --ignore-files 'node_modules/**' 'test-results/**' 'playwright-report/**' 'tests/**' 'package*.json' 'playwright.config.cjs' '*.md'",
    "build": "web-ext build --source-dir . --artifacts-dir web-ext-artifacts --overwrite-dest --ignore-files 'node_modules/**' 'test-results/**' 'playwright-report/**' 'tests/**' 'package*.json' 'playwright.config.cjs' '*.md'"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "web-ext": "10.8.0"
  }
}
