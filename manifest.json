{
  "manifest_version": 2,
  "name": "Selective Zoom",
  "version": "0.1.0",
  "description": "Ajuste o tamanho de tipos de texto por site, sem alterar o zoom da página.",
  "browser_specific_settings": {
    "gecko": {
      "id": "selective-zoom@lucianobianc",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Selective Zoom — selecionar texto"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/selection.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
