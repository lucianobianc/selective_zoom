{
  "manifest_version": 2,
  "name": "Selective Zoom",
  "version": "0.1.0",
  "description": "Ajuste o tamanho de tipos de texto por site, sem alterar o zoom da página.",
  "browser_specific_settings": {
    "gecko": {
      "id": "selective-zoom@lucianobianc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "content/selectors.js",
      "shared/storage.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Selective Zoom — selecionar texto"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/selection.js",
        "content/selectors.js",
        "shared/storage.js",
        "content/styles.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "menus"
  ],
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Abrir ou fechar Selective Zoom"
    }
  }
}
